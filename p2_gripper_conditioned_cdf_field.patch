+def test_zero_init_and_training() -> None:
+    parameter_counts = []
+    for variant in P2_VARIANTS:
+        raw, base, pose, kwargs, base_dim, image_dim = _variant_inputs(variant)
+        model = P2CdfResidualAdapter(
+            variant=variant,
+            base_feature_dim=base_dim,
+            image_feature_dim=image_dim,
+            num_thresholds=6,
+            hidden_dim=64,
+            increment_bias=-4.0,
+        )
+        logits, residual = model(raw, base, pose, **kwargs)
+        expected = monotonic_cdf_logits_from_raw(raw, -4.0)
+        assert_close(logits, expected, 1e-7)
+        assert float(residual.abs().max().item()) == 0.0
+        assert bool(((logits[:, 1:] - logits[:, :-1]) >= -1e-7).all())
+
+        target = torch.randint(0, 2, logits.shape).float()
+        loss = F.binary_cross_entropy_with_logits(logits, target)
+        loss.backward()
+        grad = model.residual_head.weight.grad
+        assert grad is not None and float(grad.abs().sum().item()) > 0.0
+        optimizer = torch.optim.AdamW(model.parameters(), lr=1e-2)
+        optimizer.step()
+        updated, updated_residual = model(raw, base, pose, **kwargs)
+        assert float(updated_residual.abs().max().item()) > 0.0
+        assert bool(((updated[:, 1:] - updated[:, :-1]) >= -1e-7).all())
+        parameter_counts.append(sum(parameter.numel() for parameter in model.parameters()))
+    assert parameter_counts[0] < parameter_counts[1] < parameter_counts[2]

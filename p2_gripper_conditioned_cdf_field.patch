+        "num_depths": (num_depths, _scalar(arrays["num_depths"], int)),
+        "num_thresholds": (num_thresholds, _scalar(arrays["num_thresholds"], int)),
+        "action_pose_dim": (ACTION_POSE_DIM, _scalar(arrays["action_pose_dim"], int)),

+    base_val = evaluate(model, val_loader, device, False, variant, verify_identity=True)
+    best_loss = float(base_val["loss"])
+    best_epoch = 0
+    with open(metrics_path, "w", encoding="utf-8") as file:
+        file.write(json.dumps({"epoch": 0, "phase": "p1_identity", "val": base_val}) + "\n")
+    print(f"[P1-IDENTITY] {json.dumps(base_val, sort_keys=True)}", flush=True)
+
+    best_path = os.path.join(output_dir, f"checkpoint_best_p2_{variant}.tar")
+    save_p2_adapter_checkpoint(

+#!/usr/bin/env python3
+"""Shared contracts for P2 gripper-conditioned CDF probes."""
+from __future__ import annotations
+
+import copy
+import os
+from typing import Any, Dict, Mapping, Optional, Tuple
+
+import torch
+import torch.nn as nn
+
+from exact_action_cdf_common import (

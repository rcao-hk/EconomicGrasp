+
+        # The cache stores both the raw P1 Conv1d outputs and the deployed
+        # monotonic CDF logits. Reconstruct them here so a corrupted or
+        # differently ordered cache cannot silently train the P2 adapter.
+        increment_bias = _scalar(arrays["cdf_increment_bias"], float)
+        raw32 = raw.astype(np.float32)
+        base = raw32[..., :1]
+        increments = np.logaddexp(
+            np.float32(0.0),
+            raw32[..., 1:] + np.float32(increment_bias),
+        )
+        reconstructed = np.concatenate(
+            [base, base + np.cumsum(increments, axis=-1, dtype=np.float32)],
+            axis=-1,
+        )
+        reconstruction_error = float(
+            np.max(np.abs(reconstructed - logits.astype(np.float32)))
+        )
+        if not np.isfinite(reconstruction_error) or reconstruction_error > 2e-5:
+            raise ValueError(
+                f"{path}: P1 raw-to-CDF reconstruction error "
+                f"{reconstruction_error:.3e} exceeds 2e-5"
+            )
+        if np.any(np.diff(logits.astype(np.float32), axis=-1) < -1e-6):
+            raise ValueError(f"{path}: p1_cdf_logits violates monotonicity")
+
+        valid_ratio = _scalar(arrays["field_valid_ratio"], float)
+        depth_valid_ratio = _scalar(arrays["field_depth_valid_ratio"], float)
+        samples_per_action = _scalar(arrays["field_samples_per_action"], int)
+        if not (0.0 <= valid_ratio <= 1.0 and 0.0 <= depth_valid_ratio <= 1.0):
+            raise ValueError(f"{path}: invalid field valid ratios")
+        if depth_valid_ratio > valid_ratio + 1e-6:
+            raise ValueError(
+                f"{path}: depth-valid ratio {depth_valid_ratio:.6f} exceeds "
+                f"projection-valid ratio {valid_ratio:.6f}"
+            )
+        if samples_per_action <= 0:
+            raise ValueError(f"{path}: field_samples_per_action must be positive")
+        friction32 = friction.astype(np.float32)
+        distance = np.abs(friction32[..., None] - _ALLOWED_FRICTION)
+        if not (distance.min(axis=-1) < 5e-3).all():
+            raise ValueError(f"{path}: unsupported friction labels")
+        collision = np.asarray(arrays["collision_or_empty"]).astype(bool)
+        pure = np.asarray(arrays["pure_collision"]).astype(bool)
+        empty = np.asarray(arrays["empty"]).astype(bool)
+        if np.any(pure & empty) or np.any(pure & ~collision) or np.any(empty & ~collision):
+            raise ValueError(f"{path}: invalid collision/empty subsets")
+        if np.any((friction32 > 0.0) & collision):
+            raise ValueError(f"{path}: colliding action has positive friction")
+        for key, limit in {
+            "source_feature_max_abs": 5e-4,
+            "source_center_max_abs": 5e-5,
+            "source_view_max_abs": 5e-5,
+            "source_width_max_abs": 5e-5,
+            "p1_endpoint_reconstruction_max_abs": 2e-5,
+        }.items():
+            value = _scalar(arrays[key], float)
+            if not np.isfinite(value) or value < 0.0 or value > limit:
+                raise ValueError(f"{path}: {key}={value:.3e} exceeds {limit:.3e}")
+
+    return P2CacheFileMeta(
+        path=os.path.abspath(path),
+        scene_id=_scalar(arrays["scene_id"], int),
+        anno_id=_scalar(arrays["anno_id"], int),
+        dataset_idx=_scalar(arrays["dataset_idx"], int),
+        num_rows=int(rows),
+        feature_dim=int(feature_dim),
+        image_feature_dim=int(image_feature_dim),
+        num_depths=int(num_depths),
+        num_thresholds=int(num_thresholds),
+        p1_checkpoint_sha256=p1_sha,
+        source_base_checkpoint_sha256=base_sha,
+        field_config_sha256=config_sha,
+        cdf_increment_bias=_scalar(arrays["cdf_increment_bias"], float),
+    )
+
+
+def scan_p2_cache(
+    cache_dir: str,
+    *,
+    expected_p1_checkpoint_sha256: Optional[str] = None,
+    expected_source_base_checkpoint_sha256: Optional[str] = None,
+    expected_field_config_sha256: Optional[str] = None,
+    max_files: int = 0,
+    strict: bool = True,
+    check_values: bool = True,
+) -> Tuple[List[P2CacheFileMeta], P2CacheInventory, List[Tuple[str, str]]]:
+    cache_dir = os.path.abspath(cache_dir)
+    files = sorted(glob.glob(os.path.join(cache_dir, "scene_*", "ann_*.npz")))
+    if max_files > 0:
+        files = files[: int(max_files)]
+    if not files:
+        raise FileNotFoundError(f"No P2 cache files under {cache_dir}")
+    metadata: List[P2CacheFileMeta] = []
+    failures: List[Tuple[str, str]] = []
+    total_actions = valid = safe08 = collision = pure = empty = 0
+    configs: Dict[str, Mapping[str, Any]] = {}
+    projected_dims: Set[int] = set()
+    ray_dims: Set[int] = set()
+
+    for path in files:
+        try:
+            with np.load(path, allow_pickle=False) as data:
+                arrays = {key: np.asarray(data[key]) for key in data.files}
+            meta = validate_p2_cache_arrays(
+                arrays,
+                path=path,
+                expected_p1_checkpoint_sha256=expected_p1_checkpoint_sha256,
+                expected_source_base_checkpoint_sha256=expected_source_base_checkpoint_sha256,
+                expected_field_config_sha256=expected_field_config_sha256,
+                check_values=check_values,
+            )
+            metadata.append(meta)
+            friction = arrays["friction"].astype(np.float32)
+            total_actions += int(friction.size)
+            valid += int((friction > 0.0).sum())
+            safe08 += int(((friction > 0.0) & (friction <= 0.8)).sum())
+            collision += int(arrays["collision_or_empty"].astype(bool).sum())
+            pure += int(arrays["pure_collision"].astype(bool).sum())
+            empty += int(arrays["empty"].astype(bool).sum())
+            config_json = _scalar(arrays["field_config_json"], str)
+            configs[meta.field_config_sha256] = json.loads(config_json)
+            projected_dims.add(_scalar(arrays["projected_feature_dim"], int))
+            ray_dims.add(_scalar(arrays["ray_feature_dim"], int))
+        except Exception as exc:
+            failures.append((path, repr(exc)))
+            if strict:
+                raise
+    if not metadata:
+        raise RuntimeError("No valid P2 cache files")
+
+    fields = {
+        "feature_dim": {m.feature_dim for m in metadata},
+        "image_feature_dim": {m.image_feature_dim for m in metadata},
+        "num_depths": {m.num_depths for m in metadata},
+        "num_thresholds": {m.num_thresholds for m in metadata},
+        "p1_checkpoint_sha256": {m.p1_checkpoint_sha256 for m in metadata},
+        "source_base_checkpoint_sha256": {m.source_base_checkpoint_sha256 for m in metadata},
+        "field_config_sha256": {m.field_config_sha256 for m in metadata},
+        "cdf_increment_bias": {round(m.cdf_increment_bias, 8) for m in metadata},
+        "projected_feature_dim": projected_dims,
+        "ray_feature_dim": ray_dims,
+    }
+    for name, values in fields.items():
+        if len(values) != 1:
+            raise RuntimeError(f"P2 cache mixes incompatible {name}: {sorted(values)}")
+    config_sha = next(iter(fields["field_config_sha256"]))
+    inventory = P2CacheInventory(
+        cache_dir=cache_dir,
+        num_files=len(metadata),
+        num_rows=sum(m.num_rows for m in metadata),
+        num_actions=total_actions,
+        scene_ids=tuple(sorted({m.scene_id for m in metadata})),
+        feature_dim=next(iter(fields["feature_dim"])),
+        image_feature_dim=next(iter(fields["image_feature_dim"])),
+        num_depths=next(iter(fields["num_depths"])),
+        num_thresholds=next(iter(fields["num_thresholds"])),
+        projected_feature_dim=next(iter(projected_dims)),
+        ray_feature_dim=next(iter(ray_dims)),
+        p1_checkpoint_sha256=next(iter(fields["p1_checkpoint_sha256"])),
+        source_base_checkpoint_sha256=next(iter(fields["source_base_checkpoint_sha256"])),
+        field_config_sha256=config_sha,
+        field_config=configs[config_sha],
+        cdf_increment_bias=next(iter(fields["cdf_increment_bias"])),
+        valid_ratio=valid / max(total_actions, 1),
+        safe08_ratio=safe08 / max(total_actions, 1),
+        collision_or_empty_ratio=collision / max(total_actions, 1),
+        pure_collision_ratio=pure / max(total_actions, 1),
+        empty_ratio=empty / max(total_actions, 1),
+    )
+    return metadata, inventory, failures
+
+
+class P2GripperFieldCacheDataset(Dataset):
+    """One item is one frame; all exact angle-depth actions are retained."""
+
+    def __init__(
+        self,
+        cache_dir: str,
+        *,
+        split: str,
+        val_scene_start: int = 90,
+        variant: str = "ray_depth",
+        expected_p1_checkpoint_sha256: Optional[str] = None,
+        expected_source_base_checkpoint_sha256: Optional[str] = None,
+        expected_field_config_sha256: Optional[str] = None,
+        metadata_override: Optional[Sequence[P2CacheFileMeta]] = None,
+        inventory_override: Optional[P2CacheInventory] = None,
+    ) -> None:
+        from models.p2_gripper_cdf_field import validate_variant
+
+        self.variant = validate_variant(variant)
+        if (metadata_override is None) != (inventory_override is None):
+            raise ValueError(
+                "metadata_override and inventory_override must be supplied together"
+            )
+        if metadata_override is None:
+            metadata, inventory, _ = scan_p2_cache(
+                cache_dir,
+                expected_p1_checkpoint_sha256=expected_p1_checkpoint_sha256,
+                expected_source_base_checkpoint_sha256=expected_source_base_checkpoint_sha256,
+                expected_field_config_sha256=expected_field_config_sha256,
+                strict=True,
+                check_values=True,
+            )
+        else:
+            metadata = list(metadata_override)
+            inventory = inventory_override
+            if not metadata:
+                raise RuntimeError("metadata_override is empty")
+            if expected_p1_checkpoint_sha256 and (
+                inventory.p1_checkpoint_sha256 != expected_p1_checkpoint_sha256
+            ):
+                raise RuntimeError("Overridden inventory P1 checkpoint SHA mismatch")
+            if expected_source_base_checkpoint_sha256 and (
+                inventory.source_base_checkpoint_sha256
+                != expected_source_base_checkpoint_sha256
+            ):
+                raise RuntimeError("Overridden inventory Base checkpoint SHA mismatch")
+            if expected_field_config_sha256 and (
+                inventory.field_config_sha256 != expected_field_config_sha256
+            ):
+                raise RuntimeError("Overridden inventory field config SHA mismatch")
+        split = str(split).lower()
+        if split == "train":
+            selected = [m for m in metadata if m.scene_id < int(val_scene_start)]
+        elif split == "val":
+            selected = [m for m in metadata if m.scene_id >= int(val_scene_start)]
+        elif split == "all":
+            selected = metadata
+        else:
+            raise ValueError("split must be train/val/all")
+        if not selected:
+            raise RuntimeError(f"No P2 cache frames for split={split}")
+        self.metadata = selected
+        self.inventory_all = inventory
+
+    def __len__(self) -> int:
+        return len(self.metadata)
+
+    def __getitem__(self, index: int) -> Dict[str, torch.Tensor]:
+        meta = self.metadata[index]
+        with np.load(meta.path, allow_pickle=False) as data:
+            feature = torch.as_tensor(
+                np.asarray(data["cdf_head_feature"]), dtype=torch.float32
+            )
+            raw = torch.as_tensor(np.asarray(data["p1_raw_cdf"]), dtype=torch.float32)
+            logits = torch.as_tensor(
+                np.asarray(data["p1_cdf_logits"]), dtype=torch.float32
+            )
+            pose = torch.as_tensor(
+                np.asarray(data["action_pose_feature"]), dtype=torch.float32
+            )
+            projected = None
+            ray = None
+            if self.variant in {"projected", "ray_depth"}:
+                projected = torch.as_tensor(
+                    np.asarray(data["projected_field_feature"]), dtype=torch.float32
+                )
+            if self.variant == "ray_depth":
+                ray = torch.as_tensor(
+                    np.asarray(data["ray_depth_feature"]), dtype=torch.float32
+                )
+            friction = torch.as_tensor(
+                np.asarray(data["friction"]), dtype=torch.float32
+            )
+            center_id = torch.as_tensor(
+                np.asarray(data["center_id"]), dtype=torch.long
+            )
+            angle_id = torch.as_tensor(
+                np.asarray(data["angle_id"]), dtype=torch.long
+            )
+        rows, depths = friction.shape
+        base_feature = (
+            feature[:, None, :]
+            .expand(rows, depths, feature.shape[-1])
+            .reshape(rows * depths, -1)
+        )
+        result = {
+            "base_feature": base_feature,
+            "p1_raw_cdf": raw.reshape(rows * depths, -1),
+            "p1_cdf_logits": logits.reshape(rows * depths, -1),
+            "action_pose_feature": pose.reshape(rows * depths, -1),
+            "friction": friction.reshape(-1),
+            "center_id": center_id[:, None].expand(rows, depths).reshape(-1),
+            "angle_id": angle_id[:, None].expand(rows, depths).reshape(-1),
+            "depth_id": (
+                torch.arange(depths, dtype=torch.long)
+                .view(1, depths)
+                .expand(rows, -1)
+                .reshape(-1)
+            ),
+            "scene_id": torch.tensor(meta.scene_id, dtype=torch.long),
+            "anno_id": torch.tensor(meta.anno_id, dtype=torch.long),
+        }
+        if projected is not None:
+            result["projected_field_feature"] = projected.reshape(rows * depths, -1)
+        if ray is not None:
+            result["ray_depth_feature"] = ray.reshape(rows * depths, -1)
+        return result
+
+
+def collate_p2_gripper_field(samples: Sequence[Mapping[str, torch.Tensor]]) -> Dict[str, torch.Tensor]:
+    if not samples:
+        raise ValueError("Cannot collate empty P2 batch")
+    required_keys = (
+        "base_feature",
+        "p1_raw_cdf",
+        "p1_cdf_logits",
+        "action_pose_feature",
+        "friction",
+        "center_id",
+        "angle_id",
+        "depth_id",
+    )
+    optional_keys = ("projected_field_feature", "ray_depth_feature")
+    for key in required_keys:
+        if not all(key in sample for sample in samples):
+            raise KeyError(f"P2 batch is missing required key {key!r}")
+    output = {
+        key: torch.cat([sample[key] for sample in samples], dim=0)
+        for key in required_keys
+    }
+    for key in optional_keys:
+        present = [key in sample for sample in samples]
+        if any(present) and not all(present):
+            raise RuntimeError(f"P2 batch mixes presence of optional key {key!r}")
+        if all(present):
+            output[key] = torch.cat([sample[key] for sample in samples], dim=0)
+    groups = []
+    frames = []
+    for local, sample in enumerate(samples):
+        n = int(sample["friction"].numel())
+        scene = int(sample["scene_id"])
+        anno = int(sample["anno_id"])
+        groups.append(
+            sample["center_id"].long()
+            + anno * 10_000
+            + scene * 10_000_000
+        )
+        frames.append(torch.full((n,), local, dtype=torch.long))
+    output["center_group"] = torch.cat(groups, dim=0)
+    output["frame_group"] = torch.cat(frames, dim=0)
+    output["scene_id"] = torch.stack([s["scene_id"] for s in samples])
+    output["anno_id"] = torch.stack([s["anno_id"] for s in samples])
+    return output
+
+
+def save_p2_inventory(inventory: P2CacheInventory, path: str) -> None:
+    atomic_save_json(inventory.to_dict(), path)

+        "variant": variant,
+        "adapter_contract": model.contract(),
+        "trainable_parameter_count": int(sum(p.numel() for p in model.parameters() if p.requires_grad)),
+        "cache_inventory": inventory.to_dict(),
+        "field_config": field_config.to_dict(),
+        "field_config_sha256": field_config.sha256(),
+        "p1_checkpoint_path": os.path.abspath(args.p1_checkpoint),
+        "p1_checkpoint_sha256": p1_contract.checkpoint_sha256,
